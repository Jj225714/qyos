+// AuditActionForRoute 返回路由的审计动作名：优先精确映射，未命中时按路由模板推导。
+func AuditActionForRoute(method, fullPath string) string {
+	if v, ok := auditActionOverrides[method+" "+fullPath]; ok {
+		return v
+	}
+	return deriveAuditAction(method, fullPath)
 }
 
