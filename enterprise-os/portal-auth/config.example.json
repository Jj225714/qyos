{
    "origin": "https://os.jpmamoru.com",
    "listen": { "host": "127.0.0.1", "port": 3292 },
    "issuer": "https://sso.jpmamoru.com",
    "jwksUrl": "https://sso.jpmamoru.com/.well-known/portal/jwks",
    "clientId": "<Casdoor 中 portal 应用的 Client ID>",
    "clientSecretFile": "/etc/portal-auth/client-secret",
    "scope": "openid profile email",
    "bridge": {
        "baseUrl": "http://127.0.0.1:3291",
        "tokenFile": "/etc/portal-auth/os-bridge-internal.token",
        "japiInstance": "<与 os-bridge 配置 japi.instance 相同的值>"
    },
    "sessionMaxHours": 8,
    "recheckMs": 60000,
    "recheckGraceMs": 300000,
    "apps": {
        "chat": { "launchUrl": "https://jchat.jpmamoru.com/oauth/openid" },
        "image": { "launchUrl": "https://jimage.jpmamoru.com/api/config-vault/oidc/start?return=%2Fimage" },
        "api": { "launchUrl": "https://japi.jpmamoru.com/api/v1/auth/oauth/oidc/start?redirect=%2Fdashboard" }
    }
}
